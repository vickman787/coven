  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/test-helpers.ts"
  ],
  "include": [
    "src"
  ]
