# Copy to .env and fill in real values. Never commit .env.
# Database
DATABASE_URL=postgres://coven:coven@localhost:5432/coven
POSTGRES_USER=coven
POSTGRES_PASSWORD=coven
POSTGRES_DB=coven

# x402 / payments — Base Sepolia testnet (test USDC has no value)
X402_NETWORK=testnet
X402_FACILITATOR_URL=https://x402.org/facilitator
USDC_MINT=
# Coven payer wallet (testnet only, ephemeral — generate your own with
# `pnpm --filter @coven/payments generate-wallet` and save the key in .env,
# never in .env.example and never committed).
# Coven payer address (fund with 20 test USDC at https://faucet.circle.com,
# USDC + Base Sepolia, captcha required):
COVEN_PAYEE_ADDRESS=0x38c80359CD99245f2Fae9C284579A10Af7a41932
# COVEN_PAYER_PRIVATE_KEY=0x... (put the real key in .env only)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wallets: no config needed. Users connect a browser wallet extension
# (MetaMask, Rainbow, or Coinbase Wallet) — no WalletConnect, no QR
# code, no project ID. Mobile wallets without an extension cannot
# connect this way.
